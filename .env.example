# Configurações do Endpoint LLM e Embeddings ECOA PUC-Rio
OLLAMA_URL=http://ecoa-llm.duckdns.org:11434/v1
OLLAMA_API_KEY=ollama

GENERATION_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M
EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m

# Parâmetros de Rate Limiting e Lotes (para não sobrecarregar o servidor compartilhado)
BATCH_SIZE=50
RATE_LIMIT_PAUSE_SEC=10.0
